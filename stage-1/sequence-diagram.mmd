---
title: Restaurant Rush - Stage 1 Sequence Diagram
---
sequenceDiagram
    autonumber
    actor M as Manager
    participant Main
    participant GC as GameController
    participant UI as ConsoleUI
    participant AS as ArrivalSchedule
    participant W as Waiter
    participant Ch as Chef
    participant Ca as Cashier
    participant R as Restaurant
    participant Cu as Customer
    participant O as Order
    participant T as Table

    Note over Main: main(): build Menu (3 MenuItems)<br/>and Restaurant (2 tables)
    Main->>GC: new GameController(restaurant, new ConsoleUI())
    Main->>GC: play()
    GC->>UI: showWelcome(menu)

    loop every turn (1..MAX_TURNS = 18) — playTurn(turn)
        GC->>AS: customerArrivingOn(turn)
        alt turn <= 16 and turn % 3 == 1
            AS-->>GC: arrival (new Customer)
            GC->>R: addCustomer(customer)
        else no arrival
            AS-->>GC: null
        end
        GC->>UI: showTurnStart(turn, restaurant)
        opt a customer arrived
            GC->>UI: showMessage(arrival joins queue)
        end

        rect rgb(232, 242, 255)
        Note over GC,W: Waiter step — one task per turn
        loop until valid input (errors: showError, retry)
            GC->>UI: askWaiterTask()
            UI->>M: prompt (1 seat / 2 order / 3 serve / 0 wait)
            M-->>UI: task
            alt task 0 — wait
                GC->>UI: showMessage(Waiter waits)
            else task 1..3
                GC->>UI: askCustomerId()
                UI->>M: prompt
                M-->>UI: customer id
                alt task 1 — seat
                    GC->>W: seat(restaurant, id)
                    W->>R: seatCustomer(id)
                    R->>R: findCustomer(id), findFreeTable()
                    R->>Cu: sitAt(table)
                    Cu->>T: seat(customer)
                    Note over Cu: state: WAITING → SEATED
                else task 2 — take order
                    GC->>W: takeOrder(restaurant, id)
                    W->>R: findCustomer(id), getMenu()
                    W->>Cu: chooseItem(menu)
                    Cu-->>W: MenuItem
                    W->>Cu: calculateBill(priceCents)
                    Cu-->>W: price
                    W->>Cu: placeOrder(new Order(item, price))
                    Note over Cu,O: new Order starts PREPARING<br/>customer state: SEATED → ORDERED
                else task 3 — serve (order must be READY)
                    GC->>W: serve(restaurant, id, turn)
                    W->>R: findCustomer(id)
                    W->>Cu: receiveFood(turn)
                    Cu->>O: markServed()
                    Note over Cu: state: ORDERED → EATING
                end
                W-->>GC: result message
            end
        end
        GC->>UI: showMessage(waiter result)
        end

        rect rgb(235, 255, 235)
        Note over GC,Ch: Chef step — one order per turn
        loop until valid input (errors: showError, retry)
            GC->>UI: askChefTask()
            UI->>M: prompt
            M-->>UI: customer id (0 = wait)
            alt id is not 0 (order must be PREPARING)
                GC->>Ch: prepare(restaurant, id)
                Ch->>R: findCustomer(id)
                Ch->>Cu: getOrder()
                Cu-->>Ch: order
                Ch->>O: prepareOneUnit()
                Note over O: PREPARING → READY<br/>when unitsDone = prepUnits
                Ch-->>GC: result message
                GC->>UI: showMessage(chef result)
            end
        end
        end

        rect rgb(255, 243, 230)
        Note over GC,Ca: Payment + end-of-turn updates (automatic)
        GC->>Ca: collectPayment(restaurant)
        Ca->>R: getCustomers()
        opt first customer READY_TO_PAY (max one per turn)
            Ca->>R: addRevenue(bill)
            Ca->>Cu: pay()
            Cu->>O: markPaid()
            Cu->>T: free()
            Note over Cu: state: READY_TO_PAY → PAID, table freed
            Ca-->>GC: payment message
            GC->>UI: showMessage(payment)
        end
        loop each EATING customer served on an earlier turn
            GC->>Cu: finishEating()
            Note over Cu: state: EATING → READY_TO_PAY
        end
        loop each customer still waiting for service
            GC->>Cu: loseSatisfaction()
            Note over Cu: satisfaction −8 (floored at 0)
            opt satisfaction == 0
                GC->>Cu: leaveUnhappy()
                Cu->>O: cancel()
                Cu->>T: free()
                Note over Cu: state → LEFT, table freed
                GC->>UI: showMessage(customer left)
            end
        end
        GC->>UI: showTurnEnd(turn, restaurant)
        end
    end

    GC->>GC: isVictory()
    GC->>R: getPaidCount(), getRevenueCents(), getAverageSatisfaction()
    R-->>GC: stats
    GC->>UI: showResult(victory, restaurant)
    Note over GC,UI: VICTORY: paid >= 4, revenue >= $45.00,<br/>avg satisfaction >= 60
